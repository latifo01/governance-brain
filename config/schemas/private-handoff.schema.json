{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private-handoff.schema.json",
  "title": "Private CDO handoff policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "target", "authorization", "include_roots", "include_files", "exclude_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "handoff_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "repository", "visibility"],
      "properties": {
        "host": {"const": "github.com"},
        "repository": {"const": "latifo01/governance-brain"},
        "visibility": {"const": "private"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recorded_at", "scope", "public_redistribution"],
      "properties": {
        "status": {"const": "APPROVED"},
        "recorded_at": {"type": "string", "format": "date"},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "public_redistribution": {"const": "NOT_AUTHORIZED"}
      }
    },
    "include_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^/\\\\]+$"}},
    "include_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^/\\\\]+$"}},
    "exclude_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
