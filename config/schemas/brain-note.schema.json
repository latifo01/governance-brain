{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance360.local/schemas/brain-note.schema.json",
  "title": "Governance Brain active Markdown frontmatter",
  "type": "object",
  "required": ["id", "title", "type", "domains", "status", "aliases", "tags", "evidence_sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["knowledge", "question", "index"]},
    "domains": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "status": {"enum": ["active", "deprecated"]},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_sources": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["AI_ACT", "AI_LEGAL_GUIDANCE", "AI_NICE_TO_KNOW", "AI_REGULATION_INTERNAL", "DATA_AI_CLASSIFICATION"]}
    },
    "topic": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "priority": {"enum": ["high", "medium", "low"]},
    "applies_to": {"enum": ["AI", "ALL"]},
    "answer_type": {"enum": ["boolean", "text", "choice"]},
    "depends_on": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["question_id", "equals"],
          "properties": {
            "question_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "equals": {"type": ["string", "number", "boolean", "null"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "question_fr": {"type": "string", "minLength": 1},
    "question_en": {"type": "string", "minLength": 1},
    "options": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["value", "label_fr", "label_en"],
        "properties": {
          "value": {"type": "string", "minLength": 1},
          "label_fr": {"type": "string", "minLength": 1},
          "label_en": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "question"}}, "required": ["type"]},
      "then": {"required": ["topic", "priority", "applies_to", "answer_type", "depends_on", "question_fr", "question_en"]}
    },
    {
      "if": {"properties": {"answer_type": {"const": "choice"}}, "required": ["answer_type"]},
      "then": {"required": ["options"]}
    }
  ]
}
