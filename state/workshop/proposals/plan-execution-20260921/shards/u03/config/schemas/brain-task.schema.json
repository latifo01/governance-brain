{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance360.local/schemas/brain-task.schema.json",
  "title": "Governance Brain bounded task brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "objective", "role", "author_id", "reviewer_id",
    "input_files", "evidence_allowlist", "output_root", "output_files",
    "forbidden_paths", "exit_criteria", "processing"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "objective": {"type": "string", "minLength": 1},
    "role": {"type": "string", "enum": [
      "cdo_program_lead", "source_extractor", "evidence_auditor",
      "knowledge_architect", "questionnaire_curator", "questionnaire_reviewer",
      "vault_reviewer", "domain_builder", "release_reviewer", "git_helper"
    ]},
    "author_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "reviewer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        }
      }
    },
    "evidence_allowlist": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "uniqueItems": true},
    "output_root": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+"},
    "output_files": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+"}, "uniqueItems": true},
    "forbidden_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "exit_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "authorized", "material_ids"],
      "properties": {
        "profile": {"enum": ["strict-local", "approved-remote", "no-llm"]},
        "authorized": {"type": "boolean"},
        "endpoint": {"type": ["string", "null"]},
        "material_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "uniqueItems": true},
        "authorization_ref": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$"}
      }
    }
  }
}
