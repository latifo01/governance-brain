		{"id":"4a00faec45642f7c","type":"group","x":-2760,"y":-240,"width":952,"height":660,"color":"5","label":"EU AI Act compliance"},
		{"id":"094e57d1d87adeaa","type":"group","x":-1720,"y":-225,"width":894,"height":451,"color":"5","label":"GDPR"},
		{"id":"ce3849bcc25d12aa","type":"text","text":"# [[FRIA]]\nNeed to redesign the Use Case for removing prohibited AI Usage","x":-2740,"y":226,"width":385,"height":147,"color":"2"},
		{"id":"487aa8af209af009","type":"text","text":"# Redesign to remove prohibited usage\nNeed to redesign the Use Case for removing prohibited AI Usage","x":-2740,"y":16,"width":385,"height":147,"color":"2"},
		{"id":"3584c51dd448e7f1","type":"text","text":"# Predictive AI","x":-660,"y":166,"width":250,"height":128,"color":"3"},
		{"id":"7d280bb51b01857d","type":"text","text":"# Hallucinations\nWhat would be the results of wrong result presented to the end user ?","x":-440,"y":639,"width":250,"height":147},
		{"id":"bbfea03831d38bf5","type":"text","text":"# Is it AI ?\nQuestions to check if it ia actually seen as an AI system accoording to regulation like [[EU AI Act|EU AI Act]]\n","x":-660,"y":-520,"width":320,"height":160,"color":"5"},
		{"id":"5f75aaeae4097bf5","type":"text","text":"# What kind of AI is it ?\n\nQuestions to assess which kind of models are embedded in the AI System\n\nAnswers could be any combination of :\n* Predictive or traditional AI\n* Generative AI\n* Agentic AI","x":-660,"y":-235,"width":320,"height":288,"color":"3"},
		{"id":"54c4ba2f469a9ef9","type":"text","text":"# Personal Data\nAre personal data involved in the AI System ? Does it fall under the jurisdiction of GDPR or similar local Data Privacy laws ?\n","x":-1240,"y":-205,"width":394,"height":160,"color":"5"},
		{"id":"8e420faa7e117ee7","type":"text","text":"# [[DPIA]]\nDo a [[Data Protection Impact Assessments (DPIA)|Data Protection Impact Assessment]] to detect if there is processing of personal sensitive information","x":-1700,"y":-198,"width":385,"height":147,"color":"2"},
		{"id":"06025b5b508a522a","type":"text","text":"# [[Automatic Decision Making Assessment (ADMA)|ADMA]]\nDo a [[Automatic Decision Making Assessment (ADMA)]] to verify if automatic decisions by AI using personal Data are conformant with [[GDPR]]\n\n","x":-1700,"y":6,"width":385,"height":200,"color":"2"},
		{"id":"0a03f0a6a114fcb8","type":"text","text":"# Automatic decision (Art 22)\nIs there automated decision making based on the AI System ?\n","x":-1240,"y":6,"width":394,"height":160,"color":"5"},
		{"id":"9f07165f15dadc99","type":"text","text":"# [[EU AI Act]] jurisdiction\nDo you fall under the scope of applicability of EU AI Act, or do you want to be compliant with it in the perspective of a future local law ?","x":-2260,"y":-220,"width":432,"height":165,"color":"5"},
		{"id":"0abef3488bba086e","type":"text","text":"# High risk activities from [[EU AI Act|EU AI Act]] ?\nIs there high risk activities from [[EU AI Act|EU AI Act]] ?","x":-2204,"y":220,"width":320,"height":153,"color":"5"},
		{"id":"0d8137cbcd03c3dc","type":"text","text":"# Prohibited usage under [[EU AI Act]]\nIs there prohibited activities from [[EU AI Act|EU AI Act]] ?","x":-2204,"y":6,"width":320,"height":166,"color":"5"},
		{"id":"6149440c895cdba1","type":"text","text":"# End of analysis","x":-160,"y":-235,"width":250,"height":60,"color":"2"},
		{"id":"c117fcd0f2011920","type":"text","text":"# Agentic AI","x":-81,"y":166,"width":250,"height":128,"color":"3"},
		{"id":"06f32c7e5d15688c","type":"text","text":"# Generative AI","x":-361,"y":166,"width":250,"height":128,"color":"3"},
		{"id":"2f634f6a7efbfa11","type":"text","text":"# Who are the users of the AI system ?\n\nIt could be internal users, customers, candidates, third parties\n","x":-278,"y":360,"width":394,"height":160},
		{"id":"65b452638cd9c95a","type":"text","text":"# Prompt Injection\nWhat would be the results of wrong result presented to the end user","x":44,"y":639,"width":250,"height":147},
		{"id":"77cec555223187d4","type":"text","text":"# What is the business purpose of the AI usage ?","x":-1240,"y":596,"width":394,"height":117}
